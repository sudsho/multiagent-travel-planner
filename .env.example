# LLM provider (pick one)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# Travel APIs
OPENWEATHER_API_KEY=
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
GOOGLE_MAPS_API_KEY=

# Cache
REDIS_URL=redis://localhost:6379/0
CACHE_BACKEND=sqlite  # sqlite | redis
SQLITE_CACHE_PATH=.cache/travel.db

# App
LOG_LEVEL=INFO
PLANNER_PROFILE=default  # default | budget_strict | production
LOG_JSON=false           # set true in prod for structured logs

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=2

# CORS (comma-separated, * = allow all in dev only)
CORS_ALLOW_ORIGINS=*

# Observability (optional)
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
