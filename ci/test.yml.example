name: ci
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - name: install
        run: |
          pip install -r requirements.txt
          pip install pytest-cov
      - name: lint
        run: |
          python -m pyflakes src tests || true
      - name: tests
        env:
          OPENAI_API_KEY: ""
          AMADEUS_CLIENT_ID: ""
          AMADEUS_CLIENT_SECRET: ""
          OPENWEATHER_API_KEY: ""
          GOOGLE_MAPS_API_KEY: ""
        run: |
          pytest -q --cov=src --cov-report=term

  docker:
    needs: test
    runs-on: ubuntu-latest
    if: github.ref == 'refs/heads/main'
    steps:
      - uses: actions/checkout@v4
      - name: set up buildx
        uses: docker/setup-buildx-action@v3
      - name: build image
        uses: docker/build-push-action@v6
        with:
          context: .
          push: false
          tags: multiagent-travel-planner:ci
          cache-from: type=gha
          cache-to: type=gha,mode=max
